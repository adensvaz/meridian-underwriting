# Copy to .env and fill in. .env is gitignored — never commit it.

# ---- AI ----------------------------------------------------------------
# Required for document extraction and narrative generation.
# Without it the app still runs: extraction falls back to deterministic
# rule-based parsing and narratives fall back to a template engine.
ANTHROPIC_API_KEY=

# Model used for extraction + narrative.
MERIDIAN_MODEL=claude-opus-5

# Hard ceiling on spend per extraction run. Set 0 to disable AI entirely.
MERIDIAN_MAX_DOCS_PER_DEAL=12

# ---- Server ------------------------------------------------------------
PORT=4100
# Set to "production" behind TLS so cookies get the Secure flag.
NODE_ENV=development

# ---- Security ----------------------------------------------------------
# 32+ random bytes, hex. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated at boot and persisted to data/.session-key
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Login throttling.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# ---- Uploads -----------------------------------------------------------
# Per-file ceiling in megabytes.
MAX_UPLOAD_MB=40

# ---- Locale ------------------------------------------------------------
# Default market pack for new users: AE (Dubai/UAE) or US.
DEFAULT_MARKET=AE
